          }
        }
      }
    },
    "Only owners can rent out a charger on Unplugged: homeowners and owners of charging stations.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Unplugged nuomoti įkroviklį gali tik savininkai: namų ir įkrovimo stotelių savininkai."
          }
        }
      }
    },
    "I own this home and its charger, or the owner has given me written permission to rent it out.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis namas ir įkroviklis priklauso man arba savininkas raštu leido man jį nuomoti."
          }
        }
      }
    },
    "I own these chargers, or I'm authorized to rent them out for the business that does.": {
      "localizations": {
