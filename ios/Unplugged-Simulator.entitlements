<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator builds only. On a device CarPlay needs Apple's approval for
	     the EV charging category, and App Groups need a paid developer team. -->
	<key>com.apple.developer.carplay-charging</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.lt.vilniushack.unplugged</string>
	</array>
</dict>
</plist>
